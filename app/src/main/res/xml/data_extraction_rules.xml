<?xml version="1.0" encoding="utf-8"?>
<!--
    Backups are disabled for the scaffold. Conversation transcripts and provider
    credentials are sensitive (see docs/privacy-and-security.md), so nothing is
    sent to cloud backup or device-to-device transfer. Revisit deliberately when
    M05 defines conversation retention and backup semantics.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Microphone capture is implemented in M07 (com.voicechat.agent.audio).
        RECORD_AUDIO is the only permission the app declares today; it is
        requested at the point of use, never at app start. AGENTS.md forbids
        declaring a permission without the capability that needs it, so the
        network permission is added with the first provider adapter (M14), not
        with credential storage/registry (M13), which makes no network call.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        The OpenAI adapter (M14) is the first provider that sends an LLM request
        off-device, so INTERNET is declared here. STT/TTS stay on-device; only
        the user-approved prompt/context text is sent (docs/privacy-and-security.md).
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".VoiceChatApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceAgent">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
